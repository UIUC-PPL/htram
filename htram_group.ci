module htram_group{
  initnode void registerMsgStatsCollection(void);
  // "Type name[]" is the varsize syntax charmc recognizes; "Type *name" is
  // not, and declaring the latter makes the generated allocator ignore the
  // sizes argument entirely, so every message is allocated at its full
  // compile-time capacity. The payload arrays are declared as raw bytes
  // because the aggregation core is byte-oriented; the C++ classes expose
  // typed accessors.
  message HTramMessage {
    int next;
    int cap;
    char buffer[];
  };

  message HTramLocalMessage {
    int next;
    int cap;
    char buffer[];
  };

  message HTramNodeMessage {
    int noffsets;
    char buffer[];
    int offset[];
  };

  group HTram {
    entry HTram(CkGroupID, CkGroupID, int, bool, double, bool, bool, CkCallback);
    entry HTram(CkGroupID gid, CkCallback cb);
    entry void avgLatency(CkCallback cb);
    entry void setBufferSize(int new_size);
    entry void tflush();
    entry void flush_everything();
    entry [whenidle] bool idleFlush();
    entry void receivePerPE(HTramMessage*);
    entry [expedited] void receiveOnPE(HTramMessage* msg);
    entry void receivePerPE(HTramNodeMessage*);
    entry void stop_periodic_flush();
    entry void sanityCheck();
    entry [reductiontarget] void getTotSendCount(int);
    entry [reductiontarget] void getTotRecvCount(int);
    entry [reductiontarget] void getTotTramHCount(int);
    entry void tramStats(CkCallback cb);
    entry void htramQuiesce(CkCallback cb);
    entry void onQD();
    entry void countBuffers();
    entry [reductiontarget] void onBufferCount(int total);
  };

  nodegroup HTramNodeGrp {
    entry HTramNodeGrp();
  };

  nodegroup HTramRecv {
    entry HTramRecv();
    entry [expedited] void receive(HTramMessage*);
    entry void receive_no_sort(HTramMessage*);
    entry [expedited] void receiveOnProc(HTramMessage*);
    entry void receive_small(HTramLocalMessage*);
    entry void avgLatency(CkCallback cb);
  };
};