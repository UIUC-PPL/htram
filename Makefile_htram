all: libhtram_group.a

.PHONY: htram_group.o

libhtram_group_histo.a: CFLAGS = -DHISTO
libhtram_group_histo.a: htram_group.o
	$(CHARMC_SMP) $< -o $@ -language charm++ -O3

libhtram_group_ig.a: CFLAGS = -DIG
libhtram_group_ig.a: htram_group.o
	$(CHARMC_SMP) $< -o $@ -language charm++ -O3

libhtram_group_phold.a: CFLAGS = -DPHOLD
libhtram_group_phold.a: htram_group.o
	$(CHARMC_SMP) $< -o $@ -language charm++ -O3

libhtram_group_unionfind.a: CFLAGS = -DUNIONFIND
libhtram_group_unionfind.a: htram_group.o
	$(CHARMC_SMP) $< -o $@ -language charm++ -O3

# GRAPH_INCLUDE must point to the directory containing weighted_node_struct.h
# (i.e. the charm_graph_code directory).  Pass it on the make command line:
#   make libhtram_group_graph.a GRAPH_INCLUDE=/path/to/charm_graph_code
GRAPH_INCLUDE ?= .
libhtram_group_graph.a: CFLAGS = -DGRAPH -DBUCKETS_BY_DEST -DADD_FILLERS $(HTRAM_EXTRA) -I$(GRAPH_INCLUDE) -DHTRAM_GRAPH_TYPES_HEADER=\"$(GRAPH_INCLUDE)/weighted_node_struct.h\"
libhtram_group_graph.a: htram_group.o
	$(CHARMC_SMP) $(CHARMCFLAGS) $< -o $@ -language charm++

htram_group.o: htram_group.C htram_group.h htram_combine.h htram_group.def.h htram_group.decl.h
	$(CHARMC_SMP) -c htram_group.C -gdwarf-4 -O3 $(CFLAGS)

htram_group.def.h htram_group.decl.h: htram_group.ci
	$(CHARMC_SMP) htram_group.ci -O3 $(CFLAGS)

# Convenience alias used by the main htram Makefile
libhtram_group.a: libhtram_group_unionfind.a
	cp libhtram_group_unionfind.a libhtram_group.a

clean-libs:
	rm -f *.def.h *.decl.h
	rm -f *.log.gz *.projrc *.topo *.sts *.sum
	rm -f *.a

# CombiningHold's model check. Needs no Charm++.
test_combine: tests/test_combine.cpp htram_combine.h
	$(CXX) -O2 -std=c++17 -Wall -Wextra -I. $< -o tests/$@
	tests/$@
